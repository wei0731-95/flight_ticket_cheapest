# 寄信設定（GitHub Actions 請改放在 repository secrets，不要把真實密碼 commit 進來）
#
# Gmail 需要「應用程式密碼」，不是你的 Google 登入密碼：
#   1. 到 https://myaccount.google.com/security 開啟兩步驟驗證
#   2. 到 https://myaccount.google.com/apppasswords 產生 16 碼應用程式密碼
#   3. 把那 16 碼（去掉空格）填進 SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM=your-address@gmail.com
MAIL_TO=wwojiaoao@gmail.com
